    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mssql": "^12.8.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.4.1"
  }
}
