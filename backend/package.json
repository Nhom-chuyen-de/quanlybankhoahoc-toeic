{
  "name": "toeic-master-backend",
  "version": "1.0.0",
  "description": "Backend API for TOEIC/IELTS Online Training Management Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test",
